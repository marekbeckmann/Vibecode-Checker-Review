<%- include('partials/header') %>
<h1>Search results for "<%- query %>"</h1>

<% if (products.length === 0) { %>
  <p>No gravel found matching your search.</p>
<% } else { %>
  <div class="grid">
    <% products.forEach(function (p) { %>
      <%- include('partials/card', { p: p }) %>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
