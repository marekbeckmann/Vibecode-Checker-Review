<%- include('partials/header') %>
<h1>My account</h1>
<p>Store credit: €<%= account.store_credit.toFixed(2) %></p>

<h2>Profile</h2>
<form id="profile-form" class="form">
  <label>Full name <input type="text" name="fullName" value="<%= account.full_name %>"></label>
  <label>Email <input type="email" name="email" value="<%= account.email %>"></label>
  <label>Shipping address <input type="text" name="shippingAddress" value="<%= account.shipping_address %>"></label>
  <label>Company name <input type="text" name="companyName" value="<%= account.company_name %>"></label>
  <button type="submit">Save profile</button>
</form>
<p id="profile-message"></p>

<h2>Orders</h2>
<% if (orders.length === 0) { %>
  <p>You have not placed any orders yet.</p>
<% } else { %>
  <table class="table">
    <thead><tr><th>Order</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
      <% orders.forEach(function (o) { %>
        <tr>
          <td><a href="/api/orders/<%= o.id %>">#<%= o.id %></a></td>
          <td>€<%= o.total_amount.toFixed(2) %></td>
          <td><%= o.status %></td>
          <td><%= o.created_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<p><a href="/api/orders/company-report">Company order summary report</a></p>

<h2>Redeem voucher</h2>
<form id="voucher-form" class="form">
  <label>Code <input type="text" name="code" placeholder="GRAVEL25"></label>
  <button type="submit">Redeem</button>
</form>
<p id="voucher-message"></p>

<h2>Import project spec from URL</h2>
<form id="spec-form" class="form">
  <label>Spec URL <input type="text" name="url" placeholder="https://example.com/spec.txt"></label>
  <button type="submit">Import</button>
</form>
<pre id="spec-result"></pre>
<%- include('partials/footer') %>
